{
  "name": "arabic-text-tools",
  "version": "1.0.1",
  "description": "Dependency-light Arabic text normalization and developer utilities for TypeScript.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/redaDevCraft/arabic-text-tools.git"
  },
  "bugs": {
    "url": "https://github.com/redaDevCraft/arabic-text-tools/issues"
  },
  "homepage": "https://github.com/redaDevCraft/arabic-text-tools#readme",
  "keywords": ["arabic", "rtl", "normalization", "transliteration", "text-processing"],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/cjs/index.cjs",
  "module": "./dist/esm/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.cjs"
    }
  },
  "files": ["dist", "README.md", "LICENSE"],
  "scripts": {
    "build": "npm run build:esm && npm run build:cjs && npm run build:types",
    "build:esm": "tsup src/index.ts --format esm --dts --out-dir dist/esm",
    "build:cjs": "tsup src/index.ts --format cjs --dts --out-dir dist/cjs",
    "build:types": "tsc -p tsconfig.types.json --emitDeclarationOnly",
    "test": "vitest run",
    "lint": "tsc -p tsconfig.json --noEmit",
    "prepublishOnly": "npm run build && npm test"
  },
  "devDependencies": {
    "tsup": "^8.0.2",
    "typescript": "^5.5.4",
    "vitest": "^2.0.5"
  }
}
